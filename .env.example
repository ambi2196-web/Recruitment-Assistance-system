# Copy to .env for local use. Never commit .env.
# Real values live only in the hosting provider's settings.

# Leave empty to use the built-in local database in .data/pglite.
# Use a postgres:// URL for Neon or Supabase.
DATABASE_URL=

# "mock" needs no key and makes no outside call.
# A real provider is added once it is chosen (decision D2).
LLM_PROVIDER=mock
LLM_MODEL=mock-1
LLM_API_KEY=

# Model calls are blocked when this month's estimated spend reaches this amount.
# Set to 0 to stop all model calls (the emergency stop).
MONTHLY_BUDGET_USD=25

# demo or pilot. The app refuses to start if APP_ENV=pilot and DEMO_MODE=true.
APP_ENV=demo
DEMO_MODE=true
# Required on any deployed demo. The username is "demo".
DEMO_ACCESS_PASSWORD=

# Needed from Phase 4, when real login is added.
AUTH_SECRET=
EMAIL_FROM=
EMAIL_API_KEY=

# Protects the weekly digest job (Phase 3).
CRON_SECRET=

# warn or block
UNRESOLVED_FLAG_POLICY=warn
# on or off
HINDI_DEFAULT=off
